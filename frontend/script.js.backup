function displayUser(user) {

    /* =====================================================
       NO USER LOGGED IN
    ===================================================== */

    if (!user) {

        const currentLanguage =
            getCurrentLanguage();


        const noUserMessages = {

            English: {

                name:
                    "No user logged in",

                email:
                    "Please log in to view your profile"

            },


            Hindi: {

                name:
                    "à¤•à¥‹à¤ˆ à¤‰à¤ªà¤¯à¥‹à¤—à¤•à¤°à¥à¤¤à¤¾ à¤²à¥‰à¤— à¤‡à¤¨ à¤¨à¤¹à¥€à¤‚ à¤¹à¥ˆ",

                email:
                    "à¤…à¤ªà¤¨à¥€ à¤ªà¥à¤°à¥‹à¤«à¤¼à¤¾à¤‡à¤² à¤¦à¥‡à¤–à¤¨à¥‡ à¤•à¥‡ à¤²à¤¿à¤ à¤²à¥‰à¤— à¤‡à¤¨ à¤•à¤°à¥‡à¤‚"

            },


            Bengali: {

                name:
                    "à¦•à§‹à¦¨à¦“ à¦¬à§à¦¯à¦¬à¦¹à¦¾à¦°à¦•à¦¾à¦°à§€ à¦²à¦— à¦‡à¦¨ à¦•à¦°à§‡à¦¨à¦¨à¦¿",

                email:
                    "à¦†à¦ªà¦¨à¦¾à¦° à¦ªà§à¦°à§‹à¦«à¦¾à¦‡à¦² à¦¦à§‡à¦–à¦¤à§‡ à¦²à¦— à¦‡à¦¨ à¦•à¦°à§à¦¨"

            }

        };


        const messages =
            noUserMessages[
                currentLanguage
            ] ||
            noUserMessages.English;


        if (profileName) {

            profileName.textContent =
                messages.name;

        }


        if (profileEmail) {

            profileEmail.textContent =
                messages.email;

        }


        if (profileAvatar) {

            profileAvatar.textContent =
                "?";

        }


        return;

    }


    /* =====================================================
       USER IS LOGGED IN
    ===================================================== */

    if (profileName) {

        profileName.textContent =
            user.name ||
            "Guest User";

    }


    if (profileEmail) {

        profileEmail.textContent =
            user.email ||
            "Guest";

    }


    if (profileAvatar) {

        const name =
            user.name ||
            "Guest User";


        if (user.profilePicture) {

    profileAvatar.innerHTML =
        `<img src="${user.profilePicture}" alt="Profile Picture">`;

} else {

    profileAvatar.textContent =
        user.name.charAt(0).toUpperCase();

}

    }

}


