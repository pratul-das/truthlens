console.log("EDIT PROFILE SECTION REACHED");

if (editProfileButton) {

    editProfileButton.addEventListener(
        "click",
        async function () {

            console.log(
                "Edit Profile button clicked"
            );


            const language =
                getCurrentLanguage();


            const messages =
                editProfileTranslations[
                    language
                ] ||
                editProfileTranslations.English;


            /* -----------------------------------------
               Get current user
            ----------------------------------------- */

            const currentUser =
                getSavedUser();


            /* -----------------------------------------
               No user logged in
            ----------------------------------------- */

            if (!currentUser) {

                alert(
                    messages.loginFirst
                );

                return;
            }


            /* -----------------------------------------
               Get backend access token
            ----------------------------------------- */

            const accessToken =
                sessionStorage.getItem(
                    "truthlensAccessToken"
                ) ||
                localStorage.getItem(
                    "truthlensAccessToken"
                );


            /* -----------------------------------------
               Real account required
            ----------------------------------------- */

            if (
                !accessToken ||
                currentUser.isGuest
            ) {

                alert(
                    messages.loginFirst
                );

                return;
            }


            /* -----------------------------------------
               Ask for new name
            ----------------------------------------- */

            const newName =
                prompt(
                    messages.enterName,
                    currentUser.name || ""
                );


            if (newName === null) {

                return;
            }


            const cleanedName =
                newName.trim();


            /* -----------------------------------------
               Validate name
            ----------------------------------------- */

            if (cleanedName === "") {

                alert(
                    messages.nameEmpty
                );

                return;
            }


            /* -----------------------------------------
               Ask for new email
            ----------------------------------------- */

            const newEmail =
                prompt(
                    messages.enterEmail,
                    currentUser.email || ""
                );


            if (newEmail === null) {

                return;
            }


            const cleanedEmail =
                newEmail.trim();


            /* -----------------------------------------
               Validate email
            ----------------------------------------- */

            if (cleanedEmail === "") {

                alert(
                    messages.emailEmpty
                );

                return;
            }


            if (
                !cleanedEmail.includes("@") ||
                !cleanedEmail.includes(".")
            ) {

                alert(
                    messages.invalidEmail
                );

                return;
            }


            /* -----------------------------------------
               Show update message
            ----------------------------------------- */

            console.log(
                messages.updating
            );


            try {

                /* -------------------------------------
                   Update backend database
                ------------------------------------- */

                const response =
                    await fetch(
                        "http://127.0.0.1:8000/profile",
                        {
                            method: "PUT",

                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Authorization":
                                    "Bearer " +
                                    accessToken
                            },

                            body:
                                JSON.stringify({
                                    name:
                                        cleanedName,

                                    email:
                                        cleanedEmail
                                })
                        }
                    );


               const data =
    await response.json();

if (data.access_token) {

    if (
        sessionStorage.getItem(
            "truthlensAccessToken"
        )
    ) {

        sessionStorage.setItem(
            "truthlensAccessToken",
            data.access_token
        );

    } else {

        localStorage.setItem(
            "truthlensAccessToken",
            data.access_token
        );
    }
}


                /* -------------------------------------
                   Backend error
                ------------------------------------- */

                if (!response.ok) {

                    throw new Error(
                        data.detail ||
                        messages.updateFailed
                    );
                }


                /* -------------------------------------
                   Get updated backend user
                ------------------------------------- */

                const updatedUser =
                    data.user;


                if (!updatedUser) {

                    throw new Error(
                        messages.updateFailed
                    );
                }


                const userData = {

                    id:
                        updatedUser.id,

                    name:
                        updatedUser.name,

                    email:
                        updatedUser.email,

                    isGuest:
                        false,

                    profilePicture:
                        currentUser.profilePicture ||
                        null
                };


                /* -------------------------------------
                   Save updated user
                ------------------------------------- */

                const userJSON =
                    JSON.stringify(
                        userData
                    );


                if (
                    sessionStorage.getItem(
                        "truthlensAccessToken"
                    )
                ) {

                    sessionStorage.setItem(
                        "truthlensUser",
                        userJSON
                    );

                } else {

                    localStorage.setItem(
                        "truthlensUser",
                        userJSON
                    );
                }


                /* -------------------------------------
                   Update profile immediately
                ------------------------------------- */

                displayUser(
                    userData
                );


                /* -------------------------------------
                   Success message
                ------------------------------------- */

                alert(
                    messages.success
                );


                /* -------------------------------------
                   Profile update notification
                ------------------------------------- */

                const profileNotificationTexts = {

                    English: {

                        title:
                            "Profile Updated",

                        message:
                            "Your TruthLens profile has been updated successfully."

                    },


                    Hindi: {

                        title:
                            "à¤ªà¥à¤°à¥‹à¤«à¤¼à¤¾à¤‡à¤² à¤…à¤ªà¤¡à¥‡à¤Ÿ à¤¹à¥à¤ˆ",

                        message:
                            "à¤†à¤ªà¤•à¥€ TruthLens à¤ªà¥à¤°à¥‹à¤«à¤¼à¤¾à¤‡à¤² à¤¸à¤«à¤²à¤¤à¤¾à¤ªà¥‚à¤°à¥à¤µà¤• à¤…à¤ªà¤¡à¥‡à¤Ÿ à¤¹à¥‹ à¤—à¤ˆ à¤¹à¥ˆà¥¤"

                    },


                    Bengali: {

                        title:
                            "à¦ªà§à¦°à§‹à¦«à¦¾à¦‡à¦² à¦†à¦ªà¦¡à§‡à¦Ÿ à¦¹à¦¯à¦¼à§‡à¦›à§‡",

                        message:
                            "à¦†à¦ªà¦¨à¦¾à¦° TruthLens à¦ªà§à¦°à§‹à¦«à¦¾à¦‡à¦² à¦¸à¦«à¦²à¦­à¦¾à¦¬à§‡ à¦†à¦ªà¦¡à§‡à¦Ÿ à¦¹à¦¯à¦¼à§‡à¦›à§‡à¥¤"

                    }

                };


                const profileNotification =
                    profileNotificationTexts[
                        language
                    ] ||
                    profileNotificationTexts.English;


                addTruthLensNotification(
                    profileNotification.title,
                    profileNotification.message,
                    "profile"
                );


                sendBrowserNotification(
                    profileNotification.title,
                    profileNotification.message
                );


            } catch (error) {

                console.error(
                    "Profile update error:",
                    error
                );


                alert(
                    error.message ||
                    messages.updateFailed
                );
            }
        }
    );
}


