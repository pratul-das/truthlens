) {

    togglePassword.addEventListener(
        "click",
        function () {

            if (
                professionalPassword.type ===
                "password"
            ) {

                professionalPassword.type =
                    "text";


                togglePassword.textContent =
                    "ðŸ™ˆ";


                togglePassword.setAttribute(
                    "aria-label",
                    "Hide password"
                );

            } else {

                professionalPassword.type =
                    "password";


                togglePassword.textContent =
                    "ðŸ‘ï¸";


                togglePassword.setAttribute(
                    "aria-label",
                    "Show password"
                );

            }

        }
    );

}


/* =========================================================
   CREATE NAME FROM EMAIL
========================================================= */

function createNameFromEmail(email) {

    const username =
        email.split("@")[0];


    return (
        username
            .replace(
                /[._-]+/g,
                " "
            )
            .replace(
                /\s+/g,
                " "
            )
            .trim()
            .replace(
                /\b\w/g,
                letter =>
                    letter.toUpperCase()
            ) ||
        "TruthLens User"
    );

}

/* =========================================================
   LOGIN FORM - BACKEND AUTHENTICATION
========================================================= */

if (professionalLoginForm) {

    professionalLoginForm.addEventListener(
        "submit",
        async function (event) {

            event.preventDefault();

            const emailInput =
                document.getElementById(
                    "professionalEmail"
                );

            const passwordInput =
                document.getElementById(
                    "professionalPassword"
                );

            const email =
                emailInput
                    ? emailInput.value.trim()
                    : "";

            const password =
                passwordInput
                    ? passwordInput.value
                    : "";

            /* ---------------------------------------------
               Basic validation
            --------------------------------------------- */

            if (!professionalLoginMessage) {
                return;
            }

            professionalLoginMessage.style.color =
                "#dc2626";

            if (!email || !password) {

                professionalLoginMessage.textContent =
                    "Please enter your email and password.";

                return;
            }

            if (
                !email.includes("@") ||
                !email.includes(".")
            ) {

                professionalLoginMessage.textContent =
                    "Please enter a valid email address.";

                return;
            }


            /* ---------------------------------------------
               Show loading message
            --------------------------------------------- */

            professionalLoginMessage.style.color =
                "#6b7280";

            professionalLoginMessage.textContent =
                "Signing in...";


            try {

                /* -----------------------------------------
                   Send login request to FastAPI
                ----------------------------------------- */

                const response =
                    await fetch(
                        "http://127.0.0.1:8000/login",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    email: email,
                                    password: password
                                })
                        }
                    );


                /* -----------------------------------------
                   Read backend response
                ----------------------------------------- */

                const data =
                    await response.json();


                /* -----------------------------------------
                   Handle login error
                ----------------------------------------- */

                if (!response.ok) {

                    throw new Error(
                        data.detail ||
                        "Invalid email or password."
                    );

                }


                /* -----------------------------------------
                   Backend login successful
                ----------------------------------------- */

                const user =
                    data.user;


                const accessToken =
                    data.access_token;


                if (!user || !accessToken) {

                    throw new Error(
                        "Invalid response from authentication server."
                    );

                }


                /* -----------------------------------------
                   Save authentication information
                ----------------------------------------- */

                localStorage.removeItem(
                    "truthlensLoggedOut"
                );


                localStorage.setItem(
                    "truthlensUser",
                    JSON.stringify({
                        id: user.id,
                        name: user.name,
                        email: user.email,
                        isGuest: false
                    })
                );


                /* -----------------------------------------
                   Save JWT token
                ----------------------------------------- */

                if (rememberMe && rememberMe.checked) {

    localStorage.setItem(
        "truthlensAccessToken",
        accessToken
    );

    localStorage.setItem(
        "truthlensUser",
        JSON.stringify({
            id: user.id,
            name: user.name,
            email: user.email,
            isGuest: false
        })
    );

    localStorage.setItem(
        "truthlensRememberMe",
        "true"
    );

} else {

    sessionStorage.setItem(
        "truthlensAccessToken",
        accessToken
    );

    sessionStorage.setItem(
        "truthlensUser",
        JSON.stringify({
            id: user.id,
            name: user.name,
            email: user.email,
            isGuest: false
        })
    );

    localStorage.removeItem(
        "truthlensAccessToken"
    );

    localStorage.removeItem(
        "truthlensUser"
    );

    localStorage.setItem(
        "truthlensRememberMe",
        "false"
    );
}
                /* -----------------------------------------
                   Success message
                ----------------------------------------- */

                professionalLoginMessage.style.color =
                    "#16a34a";

                professionalLoginMessage.textContent =
                    "Login successful! Welcome to TruthLens.";


                /* -----------------------------------------
                   Security notification
                ----------------------------------------- */

                if (
                    getSavedBoolean(
                        "securityNotifications",
                        true
                    )
                ) {

                    addTruthLensNotification(
                        "New Login",
                        "A new login to your TruthLens account was detected.",
                        "security"
                    );

                }


                /* -----------------------------------------
                   Redirect to Home
                ----------------------------------------- */

                setTimeout(
                    function () {

                        window.location.href =
                            "index.html";

                    },
                    700
                );

            } catch (error) {

                console.error(
                    "Login error:",
                    error
                );

                professionalLoginMessage.style.color =
                    "#dc2626";

                professionalLoginMessage.textContent =
                    error.message ||
                    "Unable to login. Please try again.";

            }

        }
    );

}

