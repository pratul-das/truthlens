function getSavedUser() {

    try {

    const saved =
        sessionStorage.getItem(
            "truthlensUser"
        ) ||
        localStorage.getItem(
            "truthlensUser"
        );


    if (!saved) {

        return null;

    }


    return JSON.parse(saved);

} catch (error) {

    console.error(
        "Unable to read user:",
        error
    );


    return null;

}
}

