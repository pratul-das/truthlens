    if (!document.body) {

        return;

    }


    if (
        document.getElementById(
            "truthlensNotificationUI"
        )
    ) {

        return;

    }


    const wrapper =
        document.createElement("div");


    wrapper.id =
        "truthlensNotificationUI";


    wrapper.innerHTML = `

        <div
            id="truthlensNotificationBell"
            title="Notifications"
            aria-label="Notifications"
            role="button"
            tabindex="0"
            style="
                position:fixed;
                right:24px;
                bottom:24px;
                width:52px;
                height:52px;
                border-radius:50%;
                background:#2563eb;
                color:white;
                display:flex;
                align-items:center;
                justify-content:center;
                cursor:pointer;
                z-index:9998;
                box-shadow:
                    0 8px 24px rgba(0,0,0,.18);
                font-size:23px;
                user-select:none;
            "
        >

            ðŸ””

            <span
                id="truthlensNotificationBadge"
                style="
                    position:absolute;
                    top:-4px;
                    right:-4px;
                    min-width:20px;
                    height:20px;
                    padding:0 5px;
                    border-radius:10px;
                    background:#dc2626;
                    color:white;
                    display:none;
                    align-items:center;
                    justify-content:center;
                    font-size:11px;
                    font-weight:700;
                    box-sizing:border-box;
                "
            ></span>

        </div>


        <div
            id="truthlensNotificationPanel"
            style="
                position:fixed;
                right:24px;
                bottom:88px;
                width:340px;
                max-width:calc(100vw - 32px);
                max-height:460px;
                background:#ffffff;
                color:#111827;
                border:1px solid #e5e7eb;
                border-radius:16px;
                box-shadow:
                    0 18px 50px rgba(0,0,0,.20);
                z-index:9999;
                display:none;
                overflow:hidden;
            "
        >

            <div
                style="
                    display:flex;
                    align-items:center;
                    justify-content:space-between;
                    gap:10px;
                    padding:15px 16px;
                    border-bottom:
                        1px solid #e5e7eb;
                "
            >

                <strong
                    id="truthlensNotificationTitle"
                >
                    Notifications
                </strong>


                <button
                    id="truthlensMarkAllRead"
                    type="button"
                    style="
                        border:0;
                        background:transparent;
                        color:#2563eb;
                        cursor:pointer;
                        font-size:12px;
                        padding:4px;
                    "
                >
                    Mark all as read
                </button>

            </div>


            <div
                id="truthlensNotificationList"
                style="
                    max-height:340px;
                    overflow-y:auto;
                "
            ></div>


            <div
                style="
                    padding:10px 16px;
                    border-top:
                        1px solid #e5e7eb;
                    text-align:right;
                "
            >

                <button
                    id="truthlensClearNotifications"
                    type="button"
                    style="
                        border:0;
                        background:transparent;
                        color:#dc2626;
                        cursor:pointer;
                        font-size:12px;
                        padding:4px;
                    "
                >
                    Clear all
                </button>

            </div>

        </div>

    `;


    document.body.appendChild(wrapper);


    const bell =
        document.getElementById(
            "truthlensNotificationBell"
        );


    const panel =
        document.getElementById(
            "truthlensNotificationPanel"
        );


    const markAllRead =
        document.getElementById(
            "truthlensMarkAllRead"
        );


    const clearNotifications =
        document.getElementById(
            "truthlensClearNotifications"
        );


    function toggleNotificationPanel() {

        if (!panel) {

            return;

        }


        panel.style.display =
            panel.style.display === "block"
                ? "none"
                : "block";

    }


    if (bell) {

        bell.addEventListener(
            "click",
            toggleNotificationPanel
        );


        bell.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    toggleNotificationPanel();

                }

            }
        );

    }


    if (markAllRead) {

        markAllRead.addEventListener(
            "click",
            function () {

                const notifications =
                    getSavedTruthLensNotifications();


                notifications.forEach(
                    function (notification) {

                        notification.read =
                            true;

                    }
                );


                saveTruthLensNotifications(
                    notifications
                );


                renderTruthLensNotifications();

            }
        );

    }


    if (clearNotifications) {

        clearNotifications.addEventListener(
            "click",
            function () {

                localStorage.removeItem(
                    "truthlensNotifications"
                );


                renderTruthLensNotifications();

            }
        );

    }


    document.addEventListener(
        "click",
        function (event) {

            if (
                panel &&
                panel.style.display === "block" &&
                !panel.contains(event.target) &&
                bell &&
                !bell.contains(event.target)
            ) {

                panel.style.display =
                    "none";

            }

        }
    );

}


/* =========================================================
   NOTIFICATION TIME
========================================================= */

function formatNotificationTime(value) {

    const date =
        new Date(value);


    if (Number.isNaN(date.getTime())) {

        return "";

    }


    const language =
        getCurrentLanguage();


    let locale =
        "en-IN";


    if (language === "Hindi") {

        locale =
            "hi-IN";

    }


    if (language === "Bengali") {

        locale =
            "bn-IN";

    }


    return date.toLocaleString(
        locale,
        {
            dateStyle:
                "medium",

            timeStyle:
                "short"
        }
    );

}


/* =========================================================
   RENDER NOTIFICATIONS
========================================================= */

function renderTruthLensNotifications() {

    const list =
        document.getElementById(
            "truthlensNotificationList"
        );


    const badge =
        document.getElementById(
            "truthlensNotificationBadge"
        );


    const title =
        document.getElementById(
            "truthlensNotificationTitle"
        );


    const markAllRead =
        document.getElementById(
            "truthlensMarkAllRead"
        );


    const clearNotifications =
        document.getElementById(
            "truthlensClearNotifications"
        );


    if (
        !list ||
        !badge ||
        !title ||
        !markAllRead ||
        !clearNotifications
    ) {

        return;

    }


    const labels =
        getNotificationPanelText();


    title.textContent =
        labels.title;


    markAllRead.textContent =
        labels.markAll;


    clearNotifications.textContent =
        labels.clear;


    const notifications =
        getSavedTruthLensNotifications();


    const unreadCount =
        notifications.filter(
            notification =>
                !notification.read
        ).length;


    if (unreadCount > 0) {

        badge.style.display =
            "flex";


        badge.textContent =
            unreadCount > 99
                ? "99+"
                : String(unreadCount);

    } else {

        badge.style.display =
            "none";

        badge.textContent =
            "";

    }


    if (notifications.length === 0) {

        list.innerHTML = `

            <div
                style="
                    padding:28px 18px;
                    text-align:center;
                    color:#6b7280;
                    font-size:14px;
                "
            >

                ${labels.empty}

            </div>

        `;

        return;

    }


    list.innerHTML =
        "";


    notifications.forEach(
        function (notification) {

            const item =
                document.createElement("div");


            const background =
                notification.read
                    ? "#ffffff"
                    : "#eff6ff";


            item.style.cssText =
                "padding:13px 15px;" +
                "border-bottom:1px solid #e5e7eb;" +
                "cursor:pointer;" +
                "background:" +
                background +
                ";";


            const icon =
                notification.type ===
                "security"
                    ? "ðŸ”"
                    : "ðŸ”Ž";


            item.innerHTML = `

                <div
                    style="
                        display:flex;
                        align-items:flex-start;
                        justify-content:
                            space-between;
                        gap:10px;
                    "
                >

                    <strong
                        style="
                            font-size:13px;
                            line-height:1.4;
                        "
                    >

                        ${icon}

                        ${escapeHTML(
                            notification.title
                        )}

                    </strong>


                    ${
                        notification.read
                            ? ""
                            : `
                                <span
                                    style="
                                        width:7px;
                                        height:7px;
                                        flex:0 0 7px;
                                        border-radius:50%;
                                        background:#2563eb;
                                        margin-top:5px;
                                    "
                                ></span>
                            `
                    }

                </div>


                <div
                    style="
                        margin-top:5px;
                        font-size:12px;
                        line-height:1.5;
                        color:#4b5563;
                    "
                >

                    ${escapeHTML(
                        notification.message
                    )}

                </div>


                <div
                    style="
                        margin-top:6px;
                        font-size:10px;
                        color:#9ca3af;
                    "
                >

                    ${formatNotificationTime(
                        notification.time
                    )}

                </div>

            `;


            item.addEventListener(
                "click",
                function () {

                    const updated =
                        getSavedTruthLensNotifications();


                    const target =
                        updated.find(
                            entry =>
                                entry.id ===
                                notification.id
                        );


                    if (target) {

                        target.read =
                            true;

                    }


                    saveTruthLensNotifications(
                        updated
                    );


                    renderTruthLensNotifications();

                }
            );


            list.appendChild(item);

        }
    );

}


/* =========================================================
   START NOTIFICATION UI
========================================================= */

createTruthLensNotificationUI();

renderTruthLensNotifications();


/* =========================================================
   HOME PAGE - TEXT / LINK TOGGLE
========================================================= */

const checkButton =
    document.getElementById(
        "checkButton"
    );


const newsText =
    document.getElementById(
        "newsText"
    );


const newsLink =
    document.getElementById(
        "newsLink"
    );


const textOption =
    document.getElementById(
        "textOption"
    );


const linkOption =
    document.getElementById(
        "linkOption"
    );


const result =
    document.getElementById(
        "result"
    );


if (
    textOption &&
    linkOption &&
    newsText &&
    newsLink
) {

    textOption.addEventListener(
        "click",
        function () {

            textOption.classList.add(
                "active"
            );


            linkOption.classList.remove(
                "active"
            );


            newsText.style.display =
                "block";


            newsLink.style.display =
                "none";

        }
    );


    linkOption.addEventListener(
        "click",
        function () {

            linkOption.classList.add(
                "active"
            );


            textOption.classList.remove(
                "active"
            );


            newsLink.style.display =
                "block";


            newsText.style.display =
                "none";

        }
    );

}


/* =========================================================
   HOME PAGE - NEWS ANALYSIS
========================================================= */

if (checkButton) {

    checkButton.addEventListener(
        "click",
        async function () {

            let input =
                "";


            if (
                textOption &&
                textOption.classList.contains(
                    "active"
                ) &&
                newsText
            ) {

                input =
                    newsText.value.trim();

            } else if (newsLink) {

                input =
                    newsLink.value.trim();

            }


            if (!input) {

                if (result) {

                    result.innerHTML = `

                        <div
                            class="result-warning"
                        >
                            âš ï¸ Please enter some
                            news first.
                        </div>

                    `;

                }

                return;

            }


            if (result) {

                result.innerHTML = `

                    <div
                        class="result-title"
                    >
                        ðŸ” Analyzing...
                    </div>

                    <p>
                        Please wait while
                        TruthLens analyzes
                        the news.
                    </p>

                `;

            }


            try {

                const isLinkMode =
                    linkOption &&
                    linkOption.classList.contains(
                        "active"
                    );


                const endpoint =
                    isLinkMode
                        ? "http://127.0.0.1:8000/predict-url"
                        : "http://127.0.0.1:8000/predict";


                const requestBody =
                    isLinkMode
                        ? {
                            url:
                                input
                        }
                        : {
                            text:
                                input
                        };


                const response =
                    await fetch(
                        endpoint,
                        {

                            method:
                                "POST",

                            headers: {

                                "Content-Type":
                                    "application/json"

                            },

                            body:
                                JSON.stringify(
                                    requestBody
                                )

                        }
                    );


                if (!response.ok) {

                    const errorData =
                        await response
                            .json()
                            .catch(
                                () => null
                            );


                    throw new Error(
                        errorData?.detail ||
                        "Server returned an error."
                    );

                }


                const data =
                    await response.json();


                const prediction =
                    data.prediction;


                const confidence =
                    data.confidence;


                /* -------------------------
                   CONFIDENCE
                ------------------------- */

                let confidenceMessage =
                    "";


                if (
                    confidence === null ||
                    confidence === undefined
                ) {

                    confidenceMessage = `

                        <div
                            class="result-warning"
                        >

                            âš ï¸ Confidence could
                            not be calculated.

                        </div>

                    `;

                } else if (
                    confidence < 60
                ) {

                    confidenceMessage = `

                        <div
                            class="result-warning"
                        >

                            âš ï¸ Low confidence
                            <br>

                            The model is uncertain
                            about this
                            classification.

                        </div>

                    `;

                } else if (
                    confidence < 80
                ) {

                    confidenceMessage = `

                        <div
                            class="result-warning"
                        >

                            âš ï¸ Moderate confidence
                            <br>

                            Consider checking
                            this information
                            with reliable
                            sources.

                        </div>

                    `;

                } else {

                    confidenceMessage = `

                        <div
                            class="result-success"
                        >

                            âœ“ High model
                            confidence

                        </div>

                    `;

                }


                /* -------------------------
                   PREDICTION
                ------------------------- */

                let statusText =
                    "";


                let disclaimer =
                    "";


                if (
                    prediction === "Fake"
                ) {

                    statusText =
                        "âš ï¸ FAKE NEWS";


                    disclaimer = `

                        <p>

                            <strong>
                                Important:
                            </strong>

                            This is an ML
                            classification,
                            not a factual
                            verification.

                        </p>

                    `;

                } else if (
                    prediction === "Real"
                ) {

                    statusText =
                        "âœ… REAL NEWS";


                    disclaimer = `

                        <p>

                            <strong>
                                Important:
                            </strong>

                            This is an ML
                            classification,
                            not a factual
                            verification.

                        </p>

                    `;

                } else {

                    statusText =
                        "ðŸ” UNKNOWN";


                    disclaimer = `

                        <p>

                            The model returned
                            an unexpected
                            classification.

                        </p>

                    `;

                }


                const confidenceValue =
                    confidence !== null &&
                    confidence !== undefined
                        ? confidence + "%"
                        : "Not available";


                const resultClass =
                    prediction === "Fake"
                        ? "fake-result"
                        : prediction === "Real"
                            ? "real-result"
                            : "unknown-result";


                if (result) {

                    result.innerHTML = `

                        <div
                            class="
                                result-card
                                ${resultClass}
                            "
                        >

                            <div
                                class="result-header"
                            >

                                <div
                                    class="result-title"
                                >

                                    ðŸ” Analysis Complete

                                </div>


                                <div
                                    class="result-status"
                                >

                                    ${escapeHTML(
                                        statusText
                                    )}

                                </div>

                            </div>


                            <div
                                class="result-details"
                            >

                                <div
                                    class="result-detail"
                                >

                                    <span>
                                        Prediction
                                    </span>


                                    <strong>

                                        ${escapeHTML(
                                            prediction
                                        )}

                                    </strong>

                                </div>


                                <div
                                    class="result-detail"
                                >

                                    <span>
                                        Model Confidence
                                    </span>


                                    <strong>

                                        ${escapeHTML(
                                            confidenceValue
                                        )}

                                    </strong>

                                </div>

                            </div>


                            ${confidenceMessage}


                            <div
                                class="result-message"
                            >

                                ${escapeHTML(
                                    data.message ||
                                    ""
                                )}

                            </div>


                            <div
                                class="
                                    result-disclaimer
                                "
                            >

                                ${disclaimer}

                            </div>

                        </div>

                    `;

                }


                showAnalysisNotification(
                    prediction,
                    confidence
                );


            } catch (error) {

                console.error(error);


                if (result) {

                    result.innerHTML = `

                        <div
                            class="result-warning"
                        >

                            âŒ Unable to connect
                            to the TruthLens
                            server.

                        </div>


                        <p>

                            ${escapeHTML(
                                error.message
                            )}

                        </p>


                        <p>

                            Please make sure
                            the FastAPI backend
                            is running.

                        </p>

                    `;

                }

            }

        }
    );

}


/* =========================================================
   THEME
========================================================= */

const themeToggle =
    document.getElementById(
        "themeToggle"
    );


function applyTheme(theme) {

    if (!document.body) {

        return;

    }


    document.body.classList.toggle(
        "dark-mode",
        theme === "dark"
    );

}


const savedTheme =
    localStorage.getItem("theme") ||
    "light";


applyTheme(
    savedTheme
);


if (themeToggle) {

    themeToggle.checked =
        savedTheme === "dark";


    themeToggle.addEventListener(
        "change",
        function () {

            const newTheme =
                this.checked
                    ? "dark"
                    : "light";


            localStorage.setItem(
                "theme",
                newTheme
            );


            applyTheme(
                newTheme
            );

        }
    );

}


