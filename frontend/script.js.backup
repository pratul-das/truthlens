/* =========================================================
   LOAD SAVED USER + VERIFY BACKEND SESSION
========================================================= */

async function loadAuthenticatedUser() {

    const savedUser =
        getSavedUser();

    const accessToken =
        sessionStorage.getItem(
            "truthlensAccessToken"
        ) ||
        localStorage.getItem(
            "truthlensAccessToken"
        );

    /* -----------------------------------------
       Guest / no backend token
    ----------------------------------------- */

    if (!accessToken) {

        if (savedUser) {

            displayUser(
                savedUser
            );

        } else {

            displayUser(
                null
            );

        }

        return;

    }

    /* -----------------------------------------
       Verify real backend login
    ----------------------------------------- */

    const verifiedUser =
        await verifyBackendSession();

   if (verifiedUser) {

    /* -----------------------------------------
       Save verified backend user
    ----------------------------------------- */

    const verifiedUserData =
        JSON.stringify(
            verifiedUser
        );

    if (
        sessionStorage.getItem(
            "truthlensAccessToken"
        )
    ) {

        sessionStorage.setItem(
            "truthlensUser",
            verifiedUserData
        );

    } else {

        localStorage.setItem(
            "truthlensUser",
            verifiedUserData
        );
    }

    /* -----------------------------------------
       Display verified user
    ----------------------------------------- */

    displayUser(
        verifiedUser
    );

} else {

        /* -------------------------------------
           Invalid/expired token
           Clear authentication information
        ------------------------------------- */

        localStorage.removeItem(
            "truthlensAccessToken"
        );

        sessionStorage.removeItem(
            "truthlensAccessToken"
        );

        localStorage.removeItem(
            "truthlensUser"
        );

        sessionStorage.removeItem(
            "truthlensUser"
        );

        displayUser(
            null
        );

    }

}

loadAuthenticatedUser();
/* =========================================================
   SETTINGS PAGE AUTHENTICATION GUARD
========================================================= */

async function protectSettingsPage() {

    const isSettingsPage =
        window.location.pathname.endsWith(
            "settings.html"
        );

    if (!isSettingsPage) {
        return;
    }

    const accessToken =
        sessionStorage.getItem(
            "truthlensAccessToken"
        ) ||
        localStorage.getItem(
            "truthlensAccessToken"
        );

    /* -----------------------------------------
       No real login token
    ----------------------------------------- */

    if (!accessToken) {

        window.location.href =
            "register.html";

        return;
    }

    /* -----------------------------------------
       Verify backend session
    ----------------------------------------- */

    const verifiedUser =
        await verifyBackendSession();

    if (!verifiedUser) {

        localStorage.removeItem(
            "truthlensAccessToken"
        );

        sessionStorage.removeItem(
            "truthlensAccessToken"
        );

        localStorage.removeItem(
            "truthlensUser"
        );

        sessionStorage.removeItem(
            "truthlensUser"
        );

        window.location.href =
            "register.html";

        return;
    }
}
/* =========================================================
   HOME PAGE ACCESS
   Registered users + Guest users
========================================================= */

async function protectHomePage() {

    const isHomePage =
        window.location.pathname.endsWith("index.html") ||
        window.location.pathname === "/" ||
        window.location.pathname === "";

    if (!isHomePage) {
        return;
    }

    /* -----------------------------------------
       Check saved user
    ----------------------------------------- */

    const savedUser =
        getSavedUser();

    /* -----------------------------------------
       Guest user
       Allow Home + News Analysis
    ----------------------------------------- */

    if (
        savedUser &&
        savedUser.isGuest === true
    ) {
        return;
    }

    /* -----------------------------------------
       Real logged-in user
       Verify backend session
    ----------------------------------------- */

    const accessToken =
        sessionStorage.getItem(
            "truthlensAccessToken"
        ) ||
        localStorage.getItem(
            "truthlensAccessToken"
        );

    if (!accessToken) {

        window.location.href =
            "register.html";

        return;
    }

    const verifiedUser =
        await verifyBackendSession();

    if (!verifiedUser) {

        window.location.href =
            "register.html";

        return;
    }
}

protectHomePage();

protectSettingsPage();
/* =========================================================
   LOGIN PAGE AUTHENTICATION GUARD
========================================================= */

async function protectLoginPage() {

    const isLoginPage =
        window.location.pathname.endsWith(
            "login.html"
        );

    if (!isLoginPage) {
        return;
    }
/* -----------------------------------------
   Guest users cannot access Login
   â†’ Register page
----------------------------------------- */

const savedUser =
    getSavedUser();

if (
    savedUser &&
    savedUser.isGuest === true
) {

    window.location.href =
        "register.html";

    return;
}

    /* -----------------------------------------
       Check if user intentionally clicked Login
       from Register page
    ----------------------------------------- */

    const loginIntent =
        sessionStorage.getItem(
            "truthlensLoginIntent"
        ) === "true";

    /* -----------------------------------------
       Check if user has registered before
    ----------------------------------------- */

    const hasRegistered =
        localStorage.getItem(
            "truthlensRegistered"
        ) === "true";

    /* -----------------------------------------
       Never registered and did not click
       Login intentionally
       â†’ Register page
    ----------------------------------------- */

    if (!hasRegistered && !loginIntent) {

        window.location.href =
            "register.html";

        return;
    }

    /* -----------------------------------------
       Check existing login token
    ----------------------------------------- */

    const accessToken =
        sessionStorage.getItem(
            "truthlensAccessToken"
        ) ||
        localStorage.getItem(
            "truthlensAccessToken"
        );

    /* -----------------------------------------
       No token
       â†’ Stay on Login page
    ----------------------------------------- */

    if (!accessToken) {
        return;
    }

    /* -----------------------------------------
       Verify backend session
    ----------------------------------------- */

    const verifiedUser =
        await verifyBackendSession();

    /* -----------------------------------------
       Already logged in
       â†’ Home
    ----------------------------------------- */

    if (verifiedUser) {

        window.location.href =
            "index.html";

        return;
    }
}

protectLoginPage();

