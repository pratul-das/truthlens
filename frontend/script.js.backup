                "à¤µà¤¿à¤¶à¥à¤²à¥‡à¤·à¤£ à¤ªà¥‚à¤°à¤¾ à¤¹à¥à¤†",

            message:
                prediction +
                " â€¢ à¤®à¥‰à¤¡à¤² à¤•à¤¾ à¤µà¤¿à¤¶à¥à¤µà¤¾à¤¸: " +
                (
                    confidence !== null &&
                    confidence !== undefined
                        ? confidence + "%"
                        : "à¤‰à¤ªà¤²à¤¬à¥à¤§ à¤¨à¤¹à¥€à¤‚"
                )

        },


        Bengali: {

            title:
                "à¦¬à¦¿à¦¶à§à¦²à§‡à¦·à¦£ à¦¸à¦®à§à¦ªà¦¨à§à¦¨ à¦¹à¦¯à¦¼à§‡à¦›à§‡",

            message:
                prediction +
                " â€¢ à¦®à¦¡à§‡à¦²à§‡à¦° à¦†à¦¤à§à¦®à¦¬à¦¿à¦¶à§à¦¬à¦¾à¦¸: " +
                (
                    confidence !== null &&
                    confidence !== undefined
                        ? confidence + "%"
                        : "à¦‰à¦ªà¦²à¦¬à§à¦§ à¦¨à¦¯à¦¼"
                )

        }

    };


    return (
        languages[getCurrentLanguage()] ||
        languages.English
    );

}


function showAnalysisNotification(
    prediction,
    confidence
) {

    if (
        !getSavedBoolean(
            "analysisNotifications",
            true
        )
    ) {

        return;

    }


    const notification =
        getAnalysisNotificationText(
            prediction,
            confidence
        );


    addTruthLensNotification(
        notification.title,
        notification.message,
        "analysis"
    );


    sendBrowserNotification(
        notification.title,
        notification.message
    );

}


/* =========================================================
   SECURITY NOTIFICATIONS
========================================================= */

function showSecurityNotification(
    title,
    message
) {

    if (
        !getSavedBoolean(
            "securityNotifications",
            true
        )
    ) {

        return;

    }


    addTruthLensNotification(
        title,
        message,
        "security"
    );


    sendBrowserNotification(
        title,
        message
    );

}


/* =========================================================
   NOTIFICATION UI
========================================================= */

