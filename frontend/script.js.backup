/* =========================================================
   SUPPORT LANGUAGE
========================================================= */

function applySupportLanguage(language) {

    const selected =
        supportTranslations[language] ||
        supportTranslations.English;


    /* =====================================================
       HELP, ABOUT AND PRIVACY MODALS
    ===================================================== */

    [
        ["helpModal", selected.help],
        ["aboutModal", selected.about],
        ["privacyModal", selected.privacy]

    ].forEach(function ([modalId, data]) {

        const modal =
            document.getElementById(modalId);


        if (!modal || !data) {
            return;
        }


        /* =================================================
           MODAL TITLE
        ================================================= */

        const heading =
            modal.querySelector("h2");

        if (heading && data.title) {
            heading.textContent =
                data.title;
        }


        /* =================================================
           MODAL INTRODUCTION
        ================================================= */

        const intro =
            modal.querySelector(
                ".support-modal-intro"
            );

        if (intro && data.intro) {
            intro.textContent =
                data.intro;
        }


        /* =================================================
           FAQ ITEMS
        ================================================= */

        const faqItems =
            modal.querySelectorAll(
                ".faq-item"
            );


        faqItems.forEach(function (item, index) {

            const itemData =
                data.items &&
                data.items[index];


            if (!itemData) {
                return;
            }


            const question =
                item.querySelector("h3");


            const answer =
                item.querySelector("p");


            if (question) {

                question.textContent =
                    itemData[0];

            }


            if (answer) {

                answer.textContent =
                    itemData[1];

            }

        });


        /* =================================================
           IF A TRANSLATION HAS MORE FAQ ITEMS THAN THE HTML,
           CREATE THE MISSING ITEMS AUTOMATICALLY
        ================================================= */

        const existingCount =
            faqItems.length;


        const translatedItems =
            data.items || [];


        if (
            translatedItems.length >
            existingCount
        ) {

            const content =
                modal.querySelector(
                    ".support-modal-content"
                );


            if (content) {

                for (
                    let i = existingCount;
                    i < translatedItems.length;
                    i++
                ) {

                    const itemData =
                        translatedItems[i];


                    const faqItem =
                        document.createElement("div");

                    faqItem.className =
                        "faq-item";


                    const question =
                        document.createElement("h3");

                    question.textContent =
                        itemData[0];


                    const answer =
                        document.createElement("p");

                    answer.textContent =
                        itemData[1];


                    faqItem.appendChild(
                        question
                    );

                    faqItem.appendChild(
                        answer
                    );


                    content.appendChild(
                        faqItem
                    );

                }

            }

        }

    });

}

/* =========================================================
   APPLY LANGUAGE
========================================================= */

function applyLanguage(language) {

    const selected =
        translations[language] ||
        translations.English;


    /* ---------------------------------------------
       Translate all data-i18n elements
    --------------------------------------------- */

    document
        .querySelectorAll(
            "[data-i18n]"
        )
        .forEach(
            function (element) {

                const key =
                    element.dataset.i18n;


                if (
                    selected[key] !==
                    undefined
                ) {

                    element.textContent =
                        selected[key];

                }

            }
        );


    /* ---------------------------------------------
       Translate Home placeholders
    --------------------------------------------- */

    const textInput =
        document.getElementById(
            "newsText"
        );


    const linkInput =
        document.getElementById(
            "newsLink"
        );


    if (
        textInput &&
        selected.newsTextPlaceholder
    ) {

        textInput.placeholder =
            selected.newsTextPlaceholder;

    }


    if (
        linkInput &&
        selected.newsLinkPlaceholder
    ) {

        linkInput.placeholder =
            selected.newsLinkPlaceholder;

    }


    /* ---------------------------------------------
       Support modals
    --------------------------------------------- */

    applySupportLanguage(
        language
    );


 /* ---------------------------------------------
   Notifications
--------------------------------------------- */

renderTruthLensNotifications();


