/* =========================================================
   TRUTHLENS - MAIN JAVASCRIPT
   Home + Settings + Login + Theme + Language
   Profile + Analysis Notifications + Security Notifications
   Support Modals
========================================================= */

"use strict";


/* =========================================================
   BASIC HELPERS
========================================================= */

function getCurrentLanguage() {

    return localStorage.getItem("language") || "English";

}


function getSavedBoolean(key, defaultValue = true) {

    const value =
        localStorage.getItem(key);

    if (value === null) {

        return defaultValue;

    }

    return value === "true";

}


function escapeHTML(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}
/* =========================================================
   BACKEND AUTHENTICATION
========================================================= */

async function verifyBackendSession() {

    const accessToken =
        sessionStorage.getItem(
            "truthlensAccessToken"
        ) ||
        localStorage.getItem(
            "truthlensAccessToken"
        );

    /* -----------------------------------------
       No backend token
       Guest users can continue normally
    ----------------------------------------- */

    if (!accessToken) {

        return null;

    }

    try {

        const response =
            await fetch(
                "http://127.0.0.1:8000/me",
                {
                    method: "GET",
                    headers: {
                        "Authorization":
                            "Bearer " +
                            accessToken
                    }
                }
            );

        if (!response.ok) {

    localStorage.removeItem(
        "truthlensAccessToken"
    );

    sessionStorage.removeItem(
        "truthlensAccessToken"
    );

    localStorage.removeItem(
        "truthlensUser"
    );

    sessionStorage.removeItem(
        "truthlensUser"
    );

    localStorage.setItem(
        "truthlensLoggedOut",
        "true"
    );

    return null;
}

        const data =
            await response.json();

        if (!data.user) {

            return null;

        }

       const existingUser =
    getSavedUser();

const verifiedUser = {

    id:
        data.user.id,

    name:
        data.user.name,

    email:
        data.user.email,

    isGuest:
        false,

    profilePicture:
        existingUser &&
        existingUser.profilePicture
            ? existingUser.profilePicture
            : null
};
        /* -----------------------------------------
           Keep profile data synchronized
        ----------------------------------------- */

        if (
            sessionStorage.getItem(
                "truthlensAccessToken"
            )
        ) {

            sessionStorage.setItem(
                "truthlensUser",
                JSON.stringify(
                    verifiedUser
                )
            );

        } else {

            localStorage.setItem(
                "truthlensUser",
                JSON.stringify(
                    verifiedUser
                )
            );

        }

        return verifiedUser;

    } catch (error) {

        console.error(
            "Authentication verification failed:",
            error
        );

        return null;

    }

}

/* =========================================================
   NOTIFICATION STORAGE
========================================================= */

function getSavedTruthLensNotifications() {

    try {

        const saved =
            localStorage.getItem(
                "truthlensNotifications"
            );

        if (!saved) {

            return [];

        }

        const notifications =
            JSON.parse(saved);

        return Array.isArray(notifications)
            ? notifications
            : [];

    } catch (error) {

        console.error(
            "Unable to read notifications:",
            error
        );

        return [];

    }

}


function saveTruthLensNotifications(
    notifications
) {

    localStorage.setItem(
        "truthlensNotifications",
        JSON.stringify(
            notifications.slice(0, 30)
        )
    );

}


